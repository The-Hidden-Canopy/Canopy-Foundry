if(NOT DEFINED ROOT OR NOT DEFINED WORK OR NOT DEFINED MODE)
  message(FATAL_ERROR "Explicit source, owned work directory and mode required")
endif()
if(NOT IS_ABSOLUTE "${ROOT}" OR NOT IS_ABSOLUTE "${WORK}")
  message(FATAL_ERROR "Absolute source/work paths required")
endif()
if(NOT MODE MATCHES "^(default|off|on)$")
  message(FATAL_ERROR "Unknown policy scenario")
endif()
string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef RUN_ID)
set(FIXTURE "${WORK}/${MODE}-${RUN_ID}")
if(EXISTS "${FIXTURE}")
  message(FATAL_ERROR "Fresh owned fixture required")
endif()
file(MAKE_DIRECTORY "${FIXTURE}/source")
file(WRITE "${FIXTURE}/source/CMakeLists.txt"
  "cmake_minimum_required(VERSION 3.28)\nproject(owner_admission_probe NONE)\ninclude(\"${ROOT}/cmake/LocalOwnerAdmission.cmake\")\nif(CANOPY_FOUNDRY_ENABLE_LOCAL_OWNER)\nmessage(FATAL_ERROR \"UNREFUSED_OWNER_SENTINEL\")\nendif()\n")
set(SETTINGS)
if(MODE STREQUAL "on")
  list(APPEND SETTINGS "-DCANOPY_FOUNDRY_ENABLE_LOCAL_OWNER=ON")
elseif(MODE STREQUAL "off")
  list(APPEND SETTINGS "-DCANOPY_FOUNDRY_ENABLE_LOCAL_OWNER=OFF")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${FIXTURE}/source"
  -B "${FIXTURE}/build" ${SETTINGS}
  TIMEOUT 30 RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERRORS)
if(MODE STREQUAL "on")
  if(RESULT EQUAL 0 OR NOT "${OUTPUT}${ERRORS}" MATCHES "Hub-issued job" OR
      "${OUTPUT}${ERRORS}" MATCHES "UNREFUSED_OWNER_SENTINEL")
    message(FATAL_ERROR "Owner enablement was not refused by Hub admission policy: ${RESULT}\n${OUTPUT}\n${ERRORS}")
  endif()
else()
  if(NOT RESULT EQUAL 0)
    message(FATAL_ERROR "Default/OFF configuration failed: ${RESULT}\n${OUTPUT}\n${ERRORS}")
  endif()
  file(STRINGS "${FIXTURE}/build/CMakeCache.txt" ADMISSION
    REGEX "^CANOPY_FOUNDRY_ENABLE_LOCAL_OWNER:BOOL=OFF$")
  if(NOT ADMISSION)
    message(FATAL_ERROR "Default/OFF did not preserve the disabled owner")
  endif()
endif()
message(STATUS "Owner ${MODE} policy passed; no process/training/backend owner launched")
