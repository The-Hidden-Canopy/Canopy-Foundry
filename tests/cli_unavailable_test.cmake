if(NOT DEFINED FOUNDRY OR NOT EXISTS "${FOUNDRY}")
  message(FATAL_ERROR "FOUNDRY test executable is unavailable")
endif()
execute_process(COMMAND "${FOUNDRY}" cancel absent-fixture
  RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT code EQUAL 4 OR NOT error MATCHES "no local run service is connected")
  message(FATAL_ERROR "cancel did not report the unavailable service: ${code} ${error}")
endif()
execute_process(COMMAND "${FOUNDRY}" status absent-fixture
  RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT code EQUAL 4 OR NOT error MATCHES "no local run service is connected")
  message(FATAL_ERROR "status did not report the unavailable service: ${code} ${error}")
endif()
execute_process(COMMAND "${FOUNDRY}" run absent-fixture
  RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT code EQUAL 1 OR NOT error MATCHES "Run check failed")
  message(FATAL_ERROR "run did not report the missing request: ${code} ${error}")
endif()
execute_process(COMMAND "${FOUNDRY}" run RESULT_VARIABLE code ERROR_VARIABLE error)
if(NOT code EQUAL 1 OR NOT error MATCHES "require one argument")
  message(FATAL_ERROR "Missing argument was not rejected")
endif()
execute_process(COMMAND "${FOUNDRY}" --help RESULT_VARIABLE code OUTPUT_VARIABLE output)
if(NOT code EQUAL 0 OR NOT output MATCHES "unavailable")
  message(FATAL_ERROR "Help did not explain execution availability")
endif()

# The first-use fixture is a real request shape, not a model-config file.
# A backend rejection (3) is valid; a parsing failure (1) is not.
if(NOT DEFINED FOUNDRY_EXAMPLE OR NOT EXISTS "${FOUNDRY_EXAMPLE}")
  message(FATAL_ERROR "Planning example is unavailable")
endif()
foreach(command IN ITEMS plan validate)
  execute_process(COMMAND "${FOUNDRY}" "${command}" "${FOUNDRY_EXAMPLE}"
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT code EQUAL 0 AND NOT code EQUAL 3)
    message(FATAL_ERROR "${command} could not parse the first-use example: ${code} ${error}")
  endif()
  string(JSON accepted ERROR_VARIABLE json_error GET "${output}" admission accepted)
  if(json_error)
    message(FATAL_ERROR "${command} did not emit a plan: ${json_error}")
  endif()
  if(command STREQUAL "plan")
    set(plan_output "${output}")
    set(plan_code "${code}")
  elseif(NOT output STREQUAL plan_output OR NOT code STREQUAL plan_code)
    message(FATAL_ERROR "plan and validate did not share a result")
  endif()
endforeach()
execute_process(COMMAND "${FOUNDRY}" run "${FOUNDRY_EXAMPLE}"
  RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT code EQUAL 3 AND NOT code EQUAL 4)
  message(FATAL_ERROR "run check should reject or report unavailable: ${code} ${error}")
endif()
